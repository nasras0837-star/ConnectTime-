NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Server-only API key. Keep it out of NEXT_PUBLIC variables and source control.
# Grant only the scopes required by this server (users.read and documents.read).
APPWRITE_API_KEY=
# Server-owned access collection; document ID must equal Appwrite user ID.
APPWRITE_ACCESS_DATABASE_ID=
APPWRITE_MEMBER_ACCESS_COLLECTION_ID=
# Configure only after selecting and contracting an age-verification provider.
AGE_VERIFICATION_PROVIDER=
AGE_VERIFICATION_API_KEY=
AGE_VERIFICATION_WEBHOOK_SECRET=

# Private member profile table in the existing Appwrite database.
APPWRITE_PROFILES_TABLE_ID=

# Private one-to-one messages table in the existing Appwrite database.
APPWRITE_MESSAGES_TABLE_ID=

# Private account notification preferences table in the existing Appwrite database.
APPWRITE_MEMBER_SETTINGS_TABLE_ID=

# Private text-only community posts table in the existing Appwrite database.
APPWRITE_COMMUNITY_POSTS_TABLE_ID=
