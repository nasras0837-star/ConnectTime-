# Copy to your local .env.local or configure equivalent variables in Render.
# Never commit real values. Keep APPWRITE_API_KEY server-only.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# Server-side Appwrite access. Use a least-privilege key and rotate it if exposed.
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=

# Independent member eligibility database/collection.
APPWRITE_ACCESS_DATABASE_ID=
APPWRITE_MEMBER_ACCESS_COLLECTION_ID=

# Core member data tables (private; server access only).
APPWRITE_PROFILES_TABLE_ID=
APPWRITE_MEMBER_SETTINGS_TABLE_ID=
APPWRITE_FRIEND_REQUESTS_TABLE_ID=
APPWRITE_NOTIFICATIONS_TABLE_ID=
APPWRITE_MESSAGES_TABLE_ID=

# Community feed, discussion, and safety tables (private).
APPWRITE_COMMUNITY_POSTS_TABLE_ID=
APPWRITE_COMMUNITY_COMMENTS_TABLE_ID=
APPWRITE_COMMUNITY_REACTIONS_TABLE_ID=
APPWRITE_COMMUNITY_BLOCKS_TABLE_ID=
APPWRITE_COMMUNITY_REPORTS_TABLE_ID=
APPWRITE_COMMUNITY_APPEALS_TABLE_ID=

# Community groups (private).
APPWRITE_COMMUNITY_GROUPS_TABLE_ID=
APPWRITE_COMMUNITY_GROUP_MEMBERS_TABLE_ID=
APPWRITE_COMMUNITY_GROUP_POSTS_TABLE_ID=

# Member-to-member Marketplace listings (private table; server access only).
APPWRITE_MARKETPLACE_ITEMS_TABLE_ID=

# Private member feedback survey submissions.
APPWRITE_USER_FEEDBACK_TABLE_ID=

# Private community event submissions/listings.
APPWRITE_EVENTS_TABLE_ID=

# Shared secret for the restricted staff advertising and event review queue.
# Use a long random value; enter it only in the staff review page, never in client-side config.
AD_REVIEW_ADMIN_TOKEN=

# Optional member features.
APPWRITE_FREE_TV_WATCHLIST_TABLE_ID=

# Private one-to-one calling (keep disabled until Appwrite schema and LiveKit staging checks pass).
ONE_TO_ONE_CALLS_ENABLED=false
NEXT_PUBLIC_ONE_TO_ONE_CALLS_ENABLED=false
APPWRITE_CALLS_TABLE_ID=

# LiveKit Cloud or self-hosted LiveKit video meeting service (server-only credentials).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional AI assistant. Keep the key server-only.
OPENAI_API_KEY=

# Veriff age and identity verification. Keep all credentials server-only.
VERIFF_BASE_URL=
VERIFF_API_KEY=
VERIFF_SHARED_SECRET=
VERIFF_CALLBACK_URL=https://your-connect-domain.example/api/verification/webhook
APPWRITE_VERIFICATION_RECORDS_TABLE_ID=

# Private Appwrite table for Connect Video Tube clips and per-member search signals
APPWRITE_VIDEO_TUBE_TABLE_ID=
