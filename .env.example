NEXT_PUBLIC_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
# Server-only API key. Keep it out of NEXT_PUBLIC variables and source control.
# Grant only the scopes required by this server (users.read and documents.read).
APPWRITE_API_KEY=
# Server-owned access collection; document ID must equal Appwrite user ID.
APPWRITE_ACCESS_DATABASE_ID=
APPWRITE_MEMBER_ACCESS_COLLECTION_ID=
# Configure only after selecting and contracting an age-verification provider.
AGE_VERIFICATION_WEBHOOK_SECRET=
